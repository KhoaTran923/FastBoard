{
  "name": "@repo/server",
  "version": "1.0.0",
  "description": "FastBoard Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/__tests__/integration",
    "test:coverage": "vitest run --coverage --exclude \"**/*.integration.test.ts\""
  },
  "keywords": [],
  "author": "Tran Anh Khoa",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.13.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
