# Environment for docker-compose.prod.yml.
# Copy to .env.docker and replace every secret before starting the stack:
#   cp .env.docker.example .env.docker
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fastboard

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ports published on the host
CLIENT_PORT=8080
SERVER_PORT=3001

# Where the browser reaches the API (baked into the client bundle at build time)
VITE_API_URL=http://localhost:3001/api
# Must match the client's own origin, or CORS blocks the browser
CORS_ORIGIN=http://localhost:8080
