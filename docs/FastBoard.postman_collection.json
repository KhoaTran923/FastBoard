{
  "info": {
    "name": "FastBoard API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API collection for FastBoard – Week 2 Backend Core"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "boardId", "value": "" },
    { "key": "columnId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) {",
                "  pm.collectionVariables.set('accessToken', r.data.access_token);",
                "  pm.collectionVariables.set('refreshToken', r.data.refresh_token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khoa@example.com\",\n  \"password\": \"Password1\",\n  \"full_name\": \"Tran Anh Khoa\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) {",
                "  pm.collectionVariables.set('accessToken', r.data.access_token);",
                "  pm.collectionVariables.set('refreshToken', r.data.refresh_token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khoa@example.com\",\n  \"password\": \"Password1\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "POST /projects",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) pm.collectionVariables.set('projectId', r.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"FastBoard Internship\",\n  \"description\": \"Kanban board with WASM\"\n}"
            }
          }
        },
        {
          "name": "GET /projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects"
          }
        },
        {
          "name": "GET /projects/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        },
        {
          "name": "PUT /projects/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"FastBoard Updated\"\n}" }
          }
        },
        {
          "name": "DELETE /projects/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Boards & Columns",
      "item": [
        {
          "name": "GET /projects/:id/boards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards"
          }
        },
        {
          "name": "POST /projects/:id/boards",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) pm.collectionVariables.set('boardId', r.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sprint 1\"\n}" }
          }
        },
        {
          "name": "POST /boards/:id/columns",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) pm.collectionVariables.set('columnId', r.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards/{{boardId}}/columns",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Todo\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "POST /columns/:id/tasks",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const r = pm.response.json();",
                "if (r.data) pm.collectionVariables.set('taskId', r.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards/{{boardId}}/columns/{{columnId}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement auth API\",\n  \"priority\": \"high\",\n  \"description\": \"Register + Login + Refresh token\"\n}"
            }
          }
        },
        {
          "name": "GET /columns/:id/tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards/{{boardId}}/columns/{{columnId}}/tasks"
          }
        },
        {
          "name": "PATCH /tasks/:id/move",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards/{{boardId}}/columns/{{columnId}}/tasks/{{taskId}}/move",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"column_id\": \"{{columnId}}\",\n  \"position\": 0\n}"
            }
          }
        },
        {
          "name": "DELETE /tasks/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/boards/{{boardId}}/columns/{{columnId}}/tasks/{{taskId}}"
          }
        }
      ]
    }
  ]
}
